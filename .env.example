# Project URL from Supabase → Project Settings → Data API.
# Example: https://abcdefgh.supabase.co
SUPABASE_URL=

# Secret key (service_role), from Project Settings → API Keys.
# Use the secret key, not the publishable or anon key.
# The server is the only place this value belongs.
SUPABASE_SECRET_KEY=

# Google Cloud → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
